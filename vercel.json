{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["sin1"],
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node",
      "config": { "includeFiles": ["openapi/**", "node_modules/swagger-ui-dist/**"] }
    }
  ],
  "routes": [{ "src": "/(.*)", "dest": "/index.js" }]
}

# Copy to .env for local development. Never commit .env.
PORT=3000
DATABASE_URL=postgres://localhost:5432/slsea_dev
# Generate each with: openssl rand -hex 32
JWT_SECRET=
# Master key from which the seeded devices' secrets are derived (seed + simulator only).
DEVICE_SECRET_SEED=
# Password given to the five demo SLSEA users when seeding.
DEMO_PASSWORD=

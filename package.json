{
  "name": "slsea-solar-api",
  "version": "1.0.0",
  "description": "SLSEA Real-Time Solar Generation Data API (NB6007CEM Web API Development coursework)",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.js",
    "db:check": "node --env-file-if-exists=.env scripts/check-seed.js",
    "smoke": "node --env-file-if-exists=.env scripts/smoke.js",
    "lint:openapi": "npx --yes @redocly/cli@2 lint openapi/openapi.yaml",
    "lint": "eslint .",
    "pretest": "node --env-file-if-exists=.env.test scripts/migrate.js --reset && node --env-file-if-exists=.env.test scripts/seed.js --small && node --env-file-if-exists=.env.test scripts/check-seed.js --small",
    "test": "node --env-file-if-exists=.env.test --test --test-concurrency=1 \"test/**/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "supertest": "^7.3.1"
  },
  "allowScripts": {
    "@scarf/scarf": false
  }
}
